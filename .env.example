# Database (Supabase Postgres or any PostgreSQL)
# With Supabase: DATABASE_URL = pooled connection (port 6543) — append ?pgbouncer=true&connection_limit=1
# (transaction pooling breaks prepared statements otherwise); DIRECT_URL = direct connection (port 5432).
# DIRECT_URL is used by prisma db push/migrate; if unset the app falls back to DATABASE_URL.
DATABASE_URL="postgresql://user:password@host:6543/waronimage?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host:5432/waronimage"

# OpenAI — GPT-4o analysis + DALL-E 3 generation + embeddings
OPENAI_API_KEY="sk-..."
# Optional overrides
# OPENAI_CHAT_MODEL="gpt-4o"
# OPENAI_IMAGE_MODEL="dall-e-3"   # or gpt-image-1

# Supabase Storage (image files). Without it, files land in /public/uploads (local dev only).
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
SUPABASE_SERVICE_ROLE_KEY="..."
SUPABASE_BUCKET="waronimage"

# Redis for the Bull generation queue. Without it, generation runs inline (small batches).
REDIS_URL="redis://localhost:6379"

# Public URL of this app (used to build absolute URLs for locally stored images)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WordPress credentials are stored per-site in the Site table (wpApiUrl / wpAuthToken), not here.
